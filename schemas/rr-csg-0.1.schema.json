{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zachshallbetter/reflective-rust/schemas/rr-csg-0.1.schema.json",
  "title": "Compiler Semantic Graph (CSG)",
  "description": "Normative schema for Compiler Semantic Graph exchange and compiler certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provenance",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rr-csg-0.1"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["compiler", "fixture"]
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "extractor": {
          "type": "string",
          "minLength": 1
        },
        "source_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer_key_id", "signature", "certified_at"],
      "properties": {
        "issuer_key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "certified_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "span", "minimum_access"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["crate", "module", "struct", "enum", "field", "function", "trait", "impl"]
          },
          "span": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "start_line", "end_line"],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "minimum_access": {
            "type": "string",
            "enum": ["public", "member", "owner", "administrator"]
          },
          "size_bytes": {
            "type": ["integer", "null"],
            "minimum": 0
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relationship", "minimum_access"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "type": "string",
            "minLength": 1
          },
          "minimum_access": {
            "type": "string",
            "enum": ["public", "member", "owner", "administrator"]
          }
        }
      }
    }
  }
}
