{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zachshallbetter/reflective-rust/schemas/rr-authenticated-envelope-0.1.schema.json",
  "title": "Authenticated Runtime Semantic Projection Envelope",
  "description": "Normative schema for Ed25519-signed RSP descriptor envelopes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope",
    "authentication"
  ],
  "properties": {
    "envelope": {
      "$ref": "rr-rsp-0.1.schema.json"
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature"],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/-]+$"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
